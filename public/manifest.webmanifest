{
  "name": "Loomings",
  "short_name": "Loomings",
  "description": "A markdown editor in your browser. Write, share with students, teach markdown side by side.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "background_color": "#061826",
  "theme_color": "#061826",
  "icons": [
    { "src": "/app/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/app/icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "/app/",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdown", ".mkd"],
        "text/plain": [".txt"]
      }
    }
  ],
  "launch_handler": { "client_mode": "navigate-new" }
}
