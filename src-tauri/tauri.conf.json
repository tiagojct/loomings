{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loomings",
  "version": "1.2.0",
  "identifier": "app.loomings.mac",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Loomings",
        "width": 900,
        "height": 700,
        "minWidth": 500,
        "minHeight": 400,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 18 },
        "backgroundColor": "#0D2F42",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data: tauri: asset: https://asset.localhost http://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' http://127.0.0.1:1420; connect-src 'self' ipc: http://ipc.localhost https://api.github.com http://127.0.0.1:1420 ws://127.0.0.1:1420; font-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../examples/loomings.md"],
    "category": "public.app-category.productivity",
    "shortDescription": "Minimalist Markdown writing app",
    "longDescription": "The shapes loom before they take form. A minimalist Markdown writing app with focus mode, live preview, and the Pequod theme.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["qmd"],
        "name": "Quarto Document",
        "description": "Quarto markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["rmd"],
        "name": "R Markdown Document",
        "description": "R Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt"],
        "name": "Plain Text",
        "description": "Plain text document",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
