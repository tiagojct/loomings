{
  "name": "loomings",
  "version": "2.6.4",
  "description": "A minimalist Markdown editor for the browser. Write, share with students, teach Markdown side by side.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p jsconfig.json",
    "site": "npm run build && node scripts/serve-site.mjs",
    "export:native": "vite build --config vite.citations.config.js && node scripts/export-native-resources.mjs"
  },
  "author": "Tiago Jacinto",
  "license": "MIT",
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.5",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@lezer/highlight": "^1.2.1",
    "citeproc": "^2.4.63",
    "docx": "^9.5.1",
    "markdown-it": "^14.1.0",
    "pele": "^1.13.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.4",
    "jszip": "^3.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
